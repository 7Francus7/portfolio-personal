{
  "name": "franco-dellorsi-portfolio",
  "private": true,
  "version": "2.0.0-foundation",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-publicacion.mjs",
    "build": "next build",
    "postbuild": "node scripts/check-build-limpio.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "check:demos": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-demos.mjs",
    "check:publicacion": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-publicacion.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run smoke"
  },
  "dependencies": {
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0"
  }
}
